{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fourthwall Collections Memberships API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Memberships",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List membership tiers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://storefront-api.fourthwall.com/open-api/v1.0/memberships/tiers",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "List membership tiers"
        },
        {
          "info": {
            "name": "List members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://storefront-api.fourthwall.com/open-api/v1.0/memberships/members",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "List members"
        },
        {
          "info": {
            "name": "Get member",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://storefront-api.fourthwall.com/open-api/v1.0/memberships/members/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get member"
        }
      ]
    }
  ],
  "bundled": true
}